# ═══════════════════════════════════════════════════════════
# VoltRoute — Environment Variables
# Rename this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Flask secret key (change this to a random secure string!)
SECRET_KEY=your-super-secret-key-change-me-in-production

# Optional production database URL (Postgres)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Google Maps API Key
# Get from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Directions API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# OpenChargeMap API Key (Free)
# Get from: https://openchargemap.org/site/develop/api
# Without a key it still works but with rate limits
OCM_API_KEY=your-openchargemap-api-key-here

# Flask environment (development or production)
FLASK_ENV=development
FLASK_DEBUG=true
